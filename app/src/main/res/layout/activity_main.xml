<?xml version="1.0" encoding="utf-8"?>
<!-- The shell: one scrolling screen, the dock, and the toast above it. Screens are built in Java. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:id="@+id/wrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="44dp">

                <LinearLayout
                    android:id="@+id/view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/aiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:fontFamily="@font/ibm_plex_mono_400"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <View
            android:id="@+id/dockRule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ink" />

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/deep"
            android:contentDescription="@string/nav_label"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView android:id="@+id/navMap" style="@style/DockItem" android:text="@string/nav_map" />
            <TextView android:id="@+id/navToday" style="@style/DockItem" android:layout_marginLeft="4dp" android:text="@string/nav_today" />
            <TextView android:id="@+id/navArcade" style="@style/DockItem" android:layout_marginLeft="4dp" android:text="@string/nav_arcade" />
            <TextView android:id="@+id/navProfile" style="@style/DockItem" android:layout_marginLeft="4dp" android:text="@string/nav_profile" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="84dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:alpha="0"
        android:background="@color/signal"
        android:fontFamily="@font/ibm_plex_mono_600"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:textColor="@color/deep"
        android:textSize="14sp"
        android:visibility="invisible" />
</FrameLayout>
